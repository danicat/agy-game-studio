{
  "command": "node",
  "args": ["main.mjs"],
  "restart_policy": "always",
  "display_name": "Game Studio",
  "description": "Ebitengine 2D WASM Playtest Studio & Procedural Audio/Synth Studio.",
  "has_web_ui": true,
  "ui_config": {
    "display_name": "Game Studio",
    "views": [
      {
        "path": "/playtest",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Playtest Studio"
      },
      {
        "path": "/sound",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Sound Studio",
        "file_extensions": [".music", ".sfx"]
      }
    ]
  }
}
