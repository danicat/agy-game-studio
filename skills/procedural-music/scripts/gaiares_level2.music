pattern drum_main =
  tom_mid:16 kick*5 ((snare:16 tom_mid)*2 kick*4)*2 snare (tom_mid:16*2 kick*2)*2 snare
  (((kick:8 R)*2 kick*3 R)*7 kick:16 tom_mid*3 snare tom_mid kick tom_mid kick:8 kick:16 tom_mid
  snare:8 ((R:8 kick)*3 kick*2)*6 (R:8 kick*2 snare)*2 R kick R snare R kick*2 snare (kick:8*2
  (R:8 kick)*2)*2 (R:8 kick*3 (R:8 kick)*2)*14 R kick*3 R snare:16 tom_mid kick*4 snare
  tom_mid*2 kick*3 tom_mid kick*3)*2
pattern drum_fade = (((kick:8 R)*2 kick*3 R)*5)@vol=1.000->0.005

