title "Gaiares - Mission 2 (Ice Stage - Shinobu Ogawa - 73-Bar VGM Hardware Register Reproduction)"
type song
tempo allegro 134
time 4/4

inst fm_lead        wave=ym2612_guitar gm=overdriven_guitar
inst fm_lead_echo   wave=ym2612_rhythm_guitar gm=distortion_guitar
inst high_bell      wave=ym2612_bell gm=vibraphone
inst fm_epiano      wave=ym2612_epiano gm=epiano1
