title "Ground Zero (Shinobi III: Return of the Ninja Master - 56-Bar 140s Exact DSL Reproduction)"
type song
tempo andantino 96
time 4/4

# ==============================================================================
# 1. Sega Mega Drive YM2612 + SN76489 Hybrid 11-Channel Instrument Palette
#    Reproduces Morihiko Akiyama, Hirofumi Murasaki & Masayuki Nagao's iconic
#    Track 25 ("Ground Zero") at 96 BPM (1 bar = 2.50s, 56 bars = 140.00s):
#    - Bars 1-4   (000.0s-010.0s): Intro (FM EPiano + PSG 3+3+2 Arpeggio + Bar 4 Tom Fill)
#    - Bars 5-12  (010.0s-030.0s): Section A - Cycle 1 (Main Theme + Sparse Syncopated Bass)
#    - Bars 13-20 (030.0s-050.0s): Section B - Cycle 1 (Bb/C Chorus + Am + 2-Bar Gsus4->G)
#    - Bars 21-28 (050.0s-070.0s): Section A - Cycle 2 (Main Theme + 16th Octave Bass + 16th Arp)
#    - Bars 29-36 (070.0s-090.0s): Section B - Cycle 2 (Full Tutti Chorus + Gsus4->G Climax)
#    - Bars 37-44 (090.0s-110.0s): Section A - Cycle 3 (Second Full Driving Verse Loop)
#    - Bars 45-52 (110.0s-130.0s): Section B - Cycle 3 (Second Full Tutti Chorus Loop)
#    - Bars 53-56 (130.0s-140.0s): Section A Outro (First 4 Bars of Section A with exponential fade)
# ==============================================================================
inst fm_lead        wave=ym2612_guitar gm=overdriven_guitar vol=0.17 adsr=0.004,0.12,0.88,0.08 vib=5.5,3.80 lpf=0.48
inst fm_lead_echo   wave=ym2612_rhythm_guitar gm=distortion_guitar vol=0.11 pan=0.38 adsr=0.005,0.12,0.84,0.09 vib=5.5,3.50 lpf=0.45
inst high_bell      wave=ym2612_bell gm=vibraphone vol=0.068 adsr=0.002,0.14,0.82,0.10 vib=6.0,5.20 lpf=0.72
inst fm_epiano      wave=ym2612_epiano gm=epiano1 vol=0.14 pan=-0.25 adsr=0.003,0.18,0.76,0.10 vib=5.2,0.06 lpf=0.45
inst fm_brass_pad   wave=ym2612_brass gm=brass_section adsr=0.035,0.18,0.86,0.16 lpf=0.42
inst choir_pad      wave=ym2612_strings gm=string_ensemble_1 adsr=0.060,0.20,0.86,0.18 lpf=0.38
inst psg_arp        wave=psg_arp gm=orchestral_harp vol=0.076 pan=-0.45 vib=6.2,2.40 lpf=0.48
inst psg_arp_echo   wave=psg_square gm=clavinet pan=0.50 vib=6.2,2.40 lpf=0.44
inst fm_bass        wave=ym2612_bass gm=electric_bass vol=0.21 adsr=0.002,0.09,0.84,0.04
inst sub_bass       wave=sub_bass gm=slap_bass_1 vol=0.19 lpf=0.032
inst kick           wave=kick freq=160Hz->38Hz
inst snare          wave=snare vol=0.145
inst tom_hi         wave=tom vol=0.15 freq=220Hz->96Hz
inst tom_mid        wave=tom vol=0.15 freq=175Hz->74Hz
inst tom_low        wave=tom vol=0.15 freq=135Hz->50Hz

pattern rest_4bar = R:1 | R:1 | R:1 | R:1
pattern rest_8bar = R:1 | R:1 | R:1 | R:1 | R:1 | R:1 | R:1 | R:1

# ==============================================================================
# 2. Channel 1 & 2: FM Lead Melody & SMPS 16th-Note Stereo Echo
# ==============================================================================
pattern lead_sec_a =
  E5:2 C5:8. G4:8. E5:8 |
  D5:2 F5:8. E5:8. F5:8 |
  C5:2 C5:8. Ab4:8. G4:8 |
  E5:1 |
  E5:2 C5:8. G4:8. E5:8 |
  D5:2 F5:8. E5:8. F5:8 |
  C5:2 Ab5:8. G5:8. F5:8 |
  F5:2 E5:2

pattern lead_sec_a_echo =
  R:16 E5:4.~16 C5:8. G4:8. E5:8 |
  R:16 D5:4.~16 F5:8. E5:8. F5:8 |
  R:16 C5:4.~16 C5:8. Ab4:8. G4:8 |
  R:16 E5:2.~8. |
  R:16 E5:4.~16 C5:8. G4:8. E5:8 |
  R:16 D5:4.~16 F5:8. E5:8. F5:8 |
  R:16 C5:4.~16 Ab5:8. G5:8. F5:8 |
  R:16 F5:4.~16 R:16 E5:4.~16

pattern lead_outro =
  (E5:2 C5:8. G4:8. E5:8)@vol=0.95->0.48 |
  (D5:2 F5:8. E5:8. F5:8)@vol=0.38->0.12 |
  (C5:2 C5:8. Ab4:8. G4:8)@vol=0.09->0.02 |
  (E5:1)@vol=0.02->0.00

pattern lead_outro_echo =
  (R:16 E5:4.~16 C5:8. G4:8. E5:8)@vol=0.95->0.48 |
  (R:16 D5:4.~16 F5:8. E5:8. F5:8)@vol=0.38->0.12 |
  (R:16 C5:4.~16 C5:8. Ab4:8. G4:8)@vol=0.09->0.02 |
  (R:16 E5:2.~8.)@vol=0.02->0.00

