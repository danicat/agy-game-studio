  ((Ab1:8 Ab2:8 Ab2:8 C3:8) (Ab1:8 Ab2:8 G1:8 G2:8))@vol=1.00->1.08->1.22 |
  ((C1:8 C2:8 C2:8 C3:8)*2)@vol=0.96->1.02->1.18 |
  ((C1:8 C2:8 C2:8 C3:8)*2)@vol=0.94->1.04->1.14 |
  ((Bb1:8 Bb2:8 Bb2:8 D3:8) (C1:8 C2:8 C2:8 C3:8))@vol=1.02->1.08->1.18 |
  ((Ab1:8 Ab2:8 Ab2:8 C3:8) (Ab1:8 Ab2:8 G1:8 F2:8))@vol=1.02->1.06->1.22 |
  ((F1:8 F2:8 F2:8 C3:8) (C1:8 C2:8 C2:8 C3:8))@vol=1.02->1.12->1.18

pattern sub_outro_driving =
  ((C1:8)*8)@vol=1.22->0.68 |
  ((Bb1:8)*4 (C1:8)*4)@vol=0.46->0.15 |
  ((Ab1:8)*6 (G1:8)*2)@vol=0.12->0.03 |
  ((C1:8)*8)@vol=0.03->0.005

pattern sub_sec_b =
  ((Bb1:8 F3:8)*2 (F2:8 D3:8)*2)@vol=0.92->1.04->1.22 |
  ((C2:8 E3:8)*2 (G2:8 G3:8)*2)@vol=0.94->1.12->1.28 |
  ((Bb1:8 F3:8)*3 (F2:8 D3:8))@vol=0.98->1.02->1.20 |
  ((C2:8 E3:8)*2 (G2:8 G3:8)*2)@vol=1.00->1.02->1.24 |
  ((Bb1:8 F3:8)*2 (F2:8 D3:8)*2)@vol=0.94->1.04->1.26 |
  ((A1:8 E3:8)*2 (E2:8 A3:8)*2)@vol=0.96->1.04->1.22 |
  ((G1:8 D3:8)*2 (D2:8 G3:8)*2)@vol=0.96->1.10->1.24 |
  ((G1:8 D3:8)*2 (D2:8 G3:8)*2)@vol=1.04->1.02->1.18

# ==============================================================================
# 8. Channel 11: Mega Drive DAC Kick, Snare & Toms
# ==============================================================================
pattern drums_intro =
  R:1 | R:1 | R:1 |
  R:2. tom_hi:16 tom_mid:16 tom_low:16 snare:16

pattern drums_sec_a =
  (kick:4 snare:4 kick:8 kick:8 snare:8 kick:8)*3 |
  kick:4 snare:4 kick:8 snare:8 tom_hi:8 tom_mid:8 |
  (kick:4 snare:4 kick:8 kick:8 snare:8 kick:8)*3 |
  kick:4 snare:4 kick:8 snare:8 tom_hi:16 tom_mid:16 tom_low:16 snare:16

pattern drums_outro =
  (kick:4 snare:4 kick:8 kick:8 snare:8 kick:8)@vol=0.95->0.48 |
  (kick:4 snare:4 kick:8 kick:8 snare:8 kick:8)@vol=0.38->0.12 |
  (kick:4 snare:4 kick:8 kick:8 snare:8 kick:8)@vol=0.09->0.02 |
  (kick:4 snare:4 kick:8 snare:8 tom_hi:8 tom_mid:8)@vol=0.02->0.00

pattern drums_sec_b =
  (kick:8. kick:16 snare:4 kick:8 kick:8 snare:8 kick:8)*3 |
  kick:4 snare:4 kick:8 snare:8 kick:8 snare:8 |
  (kick:8. kick:16 snare:4 kick:8 kick:8 snare:8 kick:8)*2 |
  kick:4 snare:4 kick:4 snare:8 kick:8 |
  kick:8 kick:8 snare:8 kick:8 tom_hi:8 tom_mid:8 tom_low:8 snare:8

# ==============================================================================
# 9. Master 11-Channel Arrangement (56 Bars = 140.00s @ 96 BPM)
# ==============================================================================
track ch01_fm_lead      fm_lead:      rest_4bar                       | lead_sec_a@vol=0.92@legato@lpf=0.42  | lead_sec_b@vol=1.18@legato@lpf=0.46  | lead_sec_a@vol=1.70@legato@lpf=0.32   | lead_sec_b@vol=0.96@legato@lpf=0.48  | lead_sec_a@vol=1.68@legato@lpf=0.32   | lead_sec_b@vol=0.94@legato@lpf=0.48  | lead_outro@vol=1.84@legato@lpf=0.26
