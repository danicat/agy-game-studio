track ch04_fm_epiano    fm_epiano: epiano_main | epiano_fade
track ch05_brass_pad    fm_brass_pad: brass_main | brass_fade
track ch06_choir_pad    choir_pad: choir_main | choir_fade
track ch07_psg_arp      psg_arp: arp_main | arp_fade
track ch08_psg_arp_echo psg_arp_echo: arpe_main | arpe_fade
track ch09_fm_bass      fm_bass: bass_main | bass_fade
track ch10_sub_bass     sub_bass: sub_main | sub_fade
track ch11_drums_main   kick: drum_main | drum_fade
