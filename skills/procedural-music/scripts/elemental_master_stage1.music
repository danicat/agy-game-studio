pattern drum_main =
  kick:8 R*7 kick R*5 R:16 tom_low tom_low:8 kick R*7 kick R*3 kick kick:16 snare*5 (kick:8 R
  snare R)*3 kick*2 snare R kick snare*2 kick*3 (snare:8*2 kick)*2 (kick:8*2 (snare:8 R kick
  R:16 snare (R:8 kick)*2)*7 snare R kick R:16 snare R:8 kick R tom_hi:16*2 tom_mid*2 tom_low*2
  (kick:8 R snare R kick R snare tom_low)*3 kick R snare R kick tom_hi:16*2 snare:8 tom_low
  (kick:8 R snare R kick*2 R*2)*3 kick R snare R kick tom_mid tom_low (R:8 kick R snare R kick*2
  snare)*3 R kick R snare R tom_hi:16*2 tom_mid*2 tom_low*2 (R:8 kick R snare kick*3 snare)*7 R
  kick R snare kick)*2 kick*2 snare R
pattern drum_fade = ((kick:8 R:16 snare (R:8 kick)*2 snare R)*5)@vol=1.000->0.005

track ch01_fm_lead      fm_lead: lead_main | lead_fade
track ch02_fm_lead_echo fm_lead_echo: echo_main | echo_fade
