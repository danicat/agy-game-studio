# ============================================================================
# Lament of the Fallen - Theme of Despair
# A tragic, slow gothic lament for solo cello, church organ, choir, and funeral march
# Tempo: 72 BPM (Adagio) | Key: C Minor / C Harmonic Minor | Time: 4/4
# Macro-Form: 44 Bars (146.67s): Intro(8) + SecA(12) + SecB(12) + SecC(8) + Coda(4)
# ============================================================================
title "Lament of the Fallen - Theme of Despair"
type song
tempo adagio 72
time 4/4
synth default

# ============================================================================
# INSTRUMENT DEFINITIONS
# ============================================================================
inst lead_cello     wave=cello          gm=cello             vol=0.18 pan=-0.25 lpf=0.45
inst cello_echo     wave=cello          gm=cello             vol=0.08 pan=0.30  lpf=0.35
inst tragic_violin  wave=violin         gm=violin            vol=0.15 pan=0.22  lpf=0.55
inst mournful_oboe  wave=oboe           gm=oboe              vol=0.12 pan=-0.32 lpf=0.48
inst gothic_choir   wave=ym2612_choir   gm=choir_aahs        vol=0.11 pan=0.00  lpf=0.30
inst church_organ   wave=organ          gm=church_organ      vol=0.13 pan=0.15  lpf=0.40
inst sorrow_bells   wave=ym2612_bell    gm=tubular_bells     vol=0.07 pan=-0.40 lpf=0.52
inst weeping_harp   wave=harp           gm=orchestral_harp   vol=0.09 pan=0.35  lpf=0.42
inst strings_pad    wave=ym2612_strings gm=string_ensemble_1 vol=0.10 pan=-0.12 lpf=0.32
inst somber_bass    wave=ym2612_bass    gm=acoustic_bass     vol=0.24 pan=0.00  lpf=0.055
inst sub_bass       wave=sub_bass       gm=synth_bass_1      vol=0.25 pan=0.00  lpf=0.035
# Drums (kick, snare, tom_hi, tom_mid, tom_low, hat, crash) are pre-seeded

# ============================================================================
# PHASE 1: INTRO - THE COLD RUINS (Bars 1-8)
# Bars 1-4: Funeral bell tolls over cold C pedal, weeping harp, and distant cello
# Bars 5-8: Muffled funeral toms enter as cello outlines the sorrow motif
# ============================================================================
pattern cello_intro =
  (R:1 |)*4
  C4:2. Eb4:4 | C4:2. Ab3:4 | F3:2. Ab3:4 | G3:1 |

pattern echo_intro =
  (R:1 |)*4
  R:8 C4:2 R:8 Eb4:4 | R:8 C4:2 R:8 Ab3:4 | R:8 F3:2 R:8 Ab3:4 | R:8 G3:2.~8 |

pattern violin_intro =
  (R:1 |)*8

pattern oboe_intro =
  (R:1 |)*4
  G4:1 | Eb4:1 | F4:1 | D4:1 |

pattern choir_intro =
  [C3 G3]:1~1~1~1 |
  [C3 G3 C4]:1 | [Ab2 Eb3 C4]:1 | [F2 C3 Ab3]:1 | [G2 D3 B3]:1 |

pattern organ_intro =
  (R:1 |)*4
  [C3 Eb3 G3]:1 | [C3 Eb3 Ab3]:1 | [C3 F3 Ab3]:1 | [B2 D3 G3]:1 |

pattern bells_intro =
  C5:1 | R:1 | Eb5:2 C5 | G4:1 |
  C5:2 Eb5 | C5:2 Ab4 | F4:2 Ab4 | G4:1 |

pattern harp_intro =
  (C3 G3 C4 Eb4 G4 Eb4 C4 G3):16*2 |
  (C3 G3 C4 Eb4 G4 Eb4 C4 G3):16*2 |
  (C3 G3 C4 Eb4 G4 Eb4 C4 G3):16*2 |
  (C3 G3 C4 Eb4 G4 Eb4 C4 G3):16*2 |
  (C3 G3 C4 Eb4 G4 Eb4 C4 G3):16*2 |
  (Ab2 Eb3 Ab3 C4 Eb4 C4 Ab3 Eb3):16*2 |
  (F2 C3 F3 Ab3 C4 Ab3 F3 C3):16*2 |
  (G2 D3 G3 B3 D4 B3 G3 D3):16*2 |

pattern strings_intro =
  [C3 G3 C4]:1~1~1~1 |
  [C3 G3 C4]:1 | [Ab2 Eb3 C4]:1 | [F2 C3 Ab3]:1 | [G2 D3 B3]:1 |

pattern bass_intro =
  C2:1~1~1~1 |
  C2:2. C2:4 | Ab1:2. Ab1:4 | F1:2. F1:4 | G1:1 |

pattern sub_intro =
  C1:1~1~1~1 |
  C1:1 | Ab0:1 | F0:1 | G0:1 |

pattern drm_intro =
  (R:1 |)*4
  kick:4 R:2. | kick:4 R:4 kick:4 R:4 |
  kick:4 R:4 (tom_low*2):8 kick:4 |
  (snare*2 tom_mid*2):16 (snare*3 kick):16 kick:2 |

# ============================================================================
# PHASE 2: SECTION A - THE WEIGHT OF GRIEF (Bars 9-20)
# Bars 9-12: The Cry of Despair (Cm -> Ab -> Fm -> G7)
# Bars 13-16: The Descending Lament (Cm -> Bb -> Abmaj7 -> G)
# Bars 17-20: Doomed Struggle (Fm -> Cm/Eb -> Ddim -> G7)
# ============================================================================
pattern cello_secA =
  # Bars 9-12
  C4:2. Eb4:4 | C4:2. Ab3:4 | F3:2. Ab3:4 | G3:1 |
  # Bars 13-16: Descending Lament
  Eb4:2. D4:4 | D4:2. C4:4 | C4:2. Ab3:4 | B3:1 |
  # Bars 17-20: Doomed Struggle
  C4:2. D4:4 | Eb4:2. C4:4 | D4:2. B3:4 | G3:1 |

pattern echo_secA =
  # Bars 9-12
  R:8 C4:2 R:8 Eb4:4 | R:8 C4:2 R:8 Ab3:4 | R:8 F3:2 R:8 Ab3:4 | R:8 G3:2.~8 |
  # Bars 13-16
  R:8 Eb4:2 R:8 D4:4 | R:8 D4:2 R:8 C4:4 | R:8 C4:2 R:8 Ab3:4 | R:8 B3:2.~8 |
  # Bars 17-20
  R:8 C4:2 R:8 D4:4 | R:8 Eb4:2 R:8 C4:4 | R:8 D4:2 R:8 B3:4 | R:8 G3:2.~8 |

pattern violin_secA =
  (R:1 |)*4
  G4:1~1 | Eb4:1 | D4:1 |
  F4:2. Ab4:4 | G4:2. Eb4:4 | F4:2. D4:4 | D4:1 |

pattern oboe_secA =
  G4:2. C5:4 | Eb4:2. C5:4 | C4:2. F4:4 | D4:1 |
  (R:1 |)*4
  Ab4:2. F4:4 | G4:2. Eb4:4 | F4:2. D4:4 | B3:1 |

pattern choir_secA =
  [C3 G3 C4]:1 | [Ab2 Eb3 C4]:1 | [F2 C3 Ab3]:1 | [G2 D3 B3]:1 |
  [C3 G3 C4]:1 | [Bb2 F3 D4]:1 | [Ab2 Eb3 C4]:1 | [G2 D3 B3]:1 |
  [F2 C3 Ab3]:1 | [Eb2 C3 G3]:1 | [D2 Ab2 F3]:1 | [G2 D3 B3]:1 |

pattern organ_secA =
  [C3 Eb3 G3]:1 | [C3 Eb3 Ab3]:1 | [C3 F3 Ab3]:1 | [B2 D3 G3]:1 |
  [C3 Eb3 G3]:1 | [Bb2 D3 F3]:1 | [Ab2 C3 Eb3]:1 | [G2 B2 D3]:1 |
  [F2 Ab2 C3]:1 | [Eb2 G2 C3]:1 | [D2 F2 Ab2]:1 | [G2 B2 D3]:1 |

pattern bells_secA =
  C5:2 Eb5 | C5:2 Ab4 | F4:2 Ab4 | G4:1 |
  Eb5:2 D5 | D5:2 C5 | C5:2 Ab4 | B4:1 |
  C5:2 D5 | Eb5:2 C5 | D5:2 B4 | G4:1 |

pattern harp_secA =
  (C3 G3 C4 Eb4 G4 Eb4 C4 G3):16*2 |
  (Ab2 Eb3 Ab3 C4 Eb4 C4 Ab3 Eb3):16*2 |
  (F2 C3 F3 Ab3 C4 Ab3 F3 C3):16*2 |
  (G2 D3 G3 B3 D4 B3 G3 D3):16*2 |
  (C3 G3 C4 Eb4 G4 Eb4 C4 G3):16*2 |
  (Bb2 F3 Bb3 D4 F4 D4 Bb3 F3):16*2 |
  (Ab2 Eb3 Ab3 C4 Eb4 C4 Ab3 Eb3):16*2 |
  (G2 D3 G3 B3 D4 B3 G3 D3):16*2 |
  (F2 C3 F3 Ab3 C4 Ab3 F3 C3):16*2 |
  (Eb2 C3 G3 C4 Eb4 C4 G3 C3):16*2 |
  (D2 Ab2 D3 F3 Ab3 F3 D3 Ab2):16*2 |
  (G2 D3 G3 B3 D4 B3 G3 D3):16*2 |

pattern strings_secA =
  [Eb3 G3 C4]:1 | [Eb3 Ab3 C4]:1 | [F3 Ab3 C4]:1 | [D3 G3 B3]:1 |
  [Eb3 G3 C4]:1 | [D3 F3 Bb3]:1 | [C3 Eb3 Ab3]:1 | [B2 D3 G3]:1 |
  [C3 F3 Ab3]:1 | [C3 Eb3 G3]:1 | [D3 F3 Ab3]:1 | [D3 G3 B3]:1 |

pattern bass_secA =
  C2:4. C2:8 G1:4 C2 | Ab1:4. Ab1:8 Eb1:4 Ab1 | F1:4. F1:8 C1:4 F1 | G1:4. G1:8 D1:4 G1 |
  C2:4. C2:8 G1:4 C2 | Bb1:4. Bb1:8 F1:4 Bb1 | Ab1:4. Ab1:8 Eb1:4 Ab1 | G1:4. G1:8 D1:4 G1 |
  F1:4. F1:8 C1:4 F1 | Eb1:4. Eb1:8 Bb0:4 Eb1 | D1:4. D1:8 A0:4 D1 | G1:4. G1:8 D1:4 G1 |

pattern sub_secA =
  C1:1 | Ab0:1 | F0:1 | G0:1 |
  C1:1 | Bb0:1 | Ab0:1 | G0:1 |
  F0:1 | Eb0:1 | D0:1 | G0:1 |

pattern drm_bar = kick:4 snare:4 kick:8 kick:8 snare:4 |
pattern drm_fill4 = kick:4 snare:4 kick:8 kick:8 (tom_mid*2):16 (snare*2):16 |
pattern drm_secA =
  drm_bar*3 drm_fill4
  drm_bar*3 drm_fill4
  drm_bar*3 (snare*2 tom_mid*2):16 (tom_low*2 kick*2):16 kick:2 |

# ============================================================================
# PHASE 3: SECTION B - THE CLIMAX OF AGONY (Bars 21-32)
# High tragic violin enters with full emotional outcry
# Bars 21-24: Memory of Lost Light (Abmaj7 -> Bb -> Cm -> Eb)
# Bars 25-28: Painful Realization (Fm7 -> G7 -> Cm -> C7)
# Bars 29-32: The Fall into Darkness (Fm -> Ab -> Ddim -> G7)
# ============================================================================
pattern cello_secB =
  # Bars 21-24: Memory of light
  C4:2. Eb4:4 | D4:2. F4:4 | Eb4:2. G4:4 | G4:1 |
  # Bars 25-28: Painful realization
  Ab4:2. F4:4 | F4:2. D4:4 | Eb4:2. C4:4 | E4:1 |
  # Bars 29-32: Fall into darkness
  F4:2. C4:4 | Eb4:2. C4:4 | D4:2. B3:4 | G3:1 |

pattern echo_secB =
  # Bars 21-24
  R:8 C4:2 R:8 Eb4:4 | R:8 D4:2 R:8 F4:4 | R:8 Eb4:2 R:8 G4:4 | R:8 G4:2.~8 |
  # Bars 25-28
  R:8 Ab4:2 R:8 F4:4 | R:8 F4:2 R:8 D4:4 | R:8 Eb4:2 R:8 C4:4 | R:8 E4:2.~8 |
  # Bars 29-32
  R:8 F4:2 R:8 C4:4 | R:8 Eb4:2 R:8 C4:4 | R:8 D4:2 R:8 B3:4 | R:8 G3:2.~8 |

pattern violin_secB =
  # Bars 21-24: Soaring high counterpoint
  Eb5:2. Ab5:4 | F5:2. Bb5:4 | G5:2. C6:4 | Bb5:1 |
  # Bars 25-28: Tragic cry
  C6:2. Ab5:4 | B5:2. G5:4 | G5:2. Eb5:4 | G5:1 |
  # Bars 29-32: Dying breath
  Ab5:2. F5:4 | C5:2. Eb5:4 | F5:2. D5:4 | D5:1 |

pattern oboe_secB =
  Ab4:1 | Bb4:1 | C5:1 | G4:1 |
  C5:1 | D5:1 | Eb5:1 | C5:1 |
  C5:2. Ab4:4 | Ab4:2. F4:4 | F4:2. D4:4 | B3:1 |

pattern choir_secB =
  [Ab2 Eb3 C4]:1 | [Bb2 F3 D4]:1 | [C3 G3 Eb4]:1 | [Eb3 Bb3 G4]:1 |
  [F2 C3 Ab3]:1 | [G2 D3 B3]:1 | [C3 G3 C4]:1 | [C3 G3 Bb3 E4]:1 |
  [F2 C3 Ab3]:1 | [Ab2 Eb3 C4]:1 | [D2 Ab2 F3]:1 | [G2 D3 B3]:1 |

pattern organ_secB =
  [Ab2 C3 Eb3]:1 | [Bb2 D3 F3]:1 | [C3 Eb3 G3]:1 | [Eb3 G3 Bb3]:1 |
  [F2 Ab2 C3]:1 | [G2 B2 D3]:1 | [C3 Eb3 G3]:1 | [C3 E3 G3 Bb3]:1 |
  [F2 Ab2 C3]:1 | [Ab2 C3 Eb3]:1 | [D2 F2 Ab2]:1 | [G2 B2 D3]:1 |

pattern bells_secB =
  Eb5:2 Ab5 | F5:2 Bb5 | G5:2 C6 | Bb5:1 |
  C6:2 Ab5 | B5:2 G5 | G5:2 Eb5 | G5:1 |
  Ab5:2 F5 | C5:2 Eb5 | F5:2 D5 | D5:1 |

pattern harp_secB =
  (Ab2 Eb3 Ab3 C4 Eb4 C4 Ab3 Eb3):16*2 |
  (Bb2 F3 Bb3 D4 F4 D4 Bb3 F3):16*2 |
  (C3 G3 C4 Eb4 G4 Eb4 C4 G3):16*2 |
  (Eb3 Bb3 Eb4 G4 Bb4 G4 Eb4 Bb3):16*2 |
  (F2 C3 F3 Ab3 C4 Ab3 F3 C3):16*2 |
  (G2 D3 G3 B3 D4 B3 G3 D3):16*2 |
  (C3 G3 C4 Eb4 G4 Eb4 C4 G3):16*2 |
  (C3 G3 C4 E4 G4 E4 C4 G3):16*2 |
  (F2 C3 F3 Ab3 C4 Ab3 F3 C3):16*2 |
  (Ab2 Eb3 Ab3 C4 Eb4 C4 Ab3 Eb3):16*2 |
  (D2 Ab2 D3 F3 Ab3 F3 D3 Ab2):16*2 |
  (G2 D3 G3 B3 D4 B3 G3 D3):16*2 |

pattern strings_secB =
  [C4 Eb4 Ab4]:1 | [D4 F4 Bb4]:1 | [Eb4 G4 C5]:1 | [Eb4 G4 Bb4]:1 |
  [C4 F4 Ab4]:1 | [D4 G4 B4]:1 | [C4 Eb4 G4]:1 | [Bb3 E4 G4 C5]:1 |
  [C4 F4 Ab4]:1 | [C4 Eb4 Ab4]:1 | [D4 F4 Ab4]:1 | [D4 G4 B4]:1 |

pattern bass_secB =
  Ab1:4. Ab1:8 Eb1:4 Ab1 | Bb1:4. Bb1:8 F1:4 Bb1 | C2:4. C2:8 G1:4 C2 | Eb2:4. Eb2:8 Bb1:4 Eb2 |
  F1:4. F1:8 C1:4 F1 | G1:4. G1:8 D1:4 G1 | C2:4. C2:8 G1:4 C2 | C2:4. C2:8 G1:4 C2 |
  F1:4. F1:8 C1:4 F1 | Ab1:4. Ab1:8 Eb1:4 Ab1 | D1:4. D1:8 A0:4 D1 | G1:4. G1:8 D1:4 G1 |

pattern sub_secB =
  Ab0:1 | Bb0:1 | C1:1 | Eb1:1 |
  F0:1 | G0:1 | C1:1 | C1:1 |
  F0:1 | Ab0:1 | D0:1 | G0:1 |

pattern drm_secB =
  crash:4 snare:4 kick:8 kick:8 snare:4 |
  drm_bar*2 drm_fill4
  crash:4 snare:4 kick:8 kick:8 snare:4 |
  drm_bar*2 drm_fill4
  drm_bar*3 (snare*2 tom_mid*2):16 (tom_low*2 kick*2):16 kick:2 |

# ============================================================================
# PHASE 4: SECTION C - RETURN TO EMPTINESS (Bars 33-40)
# Cello plays sorrowful recapitulation alone over fading choir and harp
# ============================================================================
pattern cello_secC =
  C4:2. Eb4:4 | C4:2. Ab3:4 | F3:2. Ab3:4 | G3:1 |
  Eb4:2. D4:4 | D4:2. C4:4 | C4:2. Ab3:4 | C4:1 |

pattern echo_secC =
  R:8 C4:2 R:8 Eb4:4 | R:8 C4:2 R:8 Ab3:4 | R:8 F3:2 R:8 Ab3:4 | R:8 G3:2.~8 |
  R:8 Eb4:2 R:8 D4:4 | R:8 D4:2 R:8 C4:4 | R:8 C4:2 R:8 Ab3:4 | R:8 C4:2.~8 |

pattern violin_secC =
  (R:1 |)*4
  G4:1~1 | Eb4:1 | D4:2 C4:2 |

pattern oboe_secC =
  (R:1 |)*8

pattern choir_secC =
  [C3 G3 C4]:1 | [Ab2 Eb3 C4]:1 | [F2 C3 Ab3]:1 | [G2 D3 B3]:1 |
  [C3 G3 C4]:1 | [Bb2 F3 D4]:1 | [Ab2 Eb3 C4]:1 | [C3 G3 C4]:1 |

pattern organ_secC =
  [C3 Eb3 G3]:1 | [C3 Eb3 Ab3]:1 | [C3 F3 Ab3]:1 | [B2 D3 G3]:1 |
  [C3 Eb3 G3]:1 | [Bb2 D3 F3]:1 | [Ab2 C3 Eb3]:1 | [C3 Eb3 G3]:1 |

pattern bells_secC =
  C5:2 Eb5 | C5:2 Ab4 | F4:2 Ab4 | G4:1 |
  Eb5:2 D5 | D5:2 C5 | C5:2 Ab4 | C5:1 |

pattern harp_secC =
  (C3 G3 C4 Eb4 G4 Eb4 C4 G3):16*2 |
  (Ab2 Eb3 Ab3 C4 Eb4 C4 Ab3 Eb3):16*2 |
  (F2 C3 F3 Ab3 C4 Ab3 F3 C3):16*2 |
  (G2 D3 G3 B3 D4 B3 G3 D3):16*2 |
  (C3 G3 C4 Eb4 G4 Eb4 C4 G3):16*2 |
  (Bb2 F3 Bb3 D4 F4 D4 Bb3 F3):16*2 |
  (Ab2 Eb3 Ab3 C4 Eb4 C4 Ab3 Eb3):16*2 |
  (C3 G3 C4 Eb4 G4 Eb4 C4 G3):16*2 |

pattern strings_secC =
  [Eb3 G3 C4]:1 | [Eb3 Ab3 C4]:1 | [F3 Ab3 C4]:1 | [D3 G3 B3]:1 |
  [Eb3 G3 C4]:1 | [D3 F3 Bb3]:1 | [C3 Eb3 Ab3]:1 | [Eb3 G3 C4]:1 |

pattern bass_secC =
  C2:2. C2:4 | Ab1:2. Ab1:4 | F1:2. F1:4 | G1:1 |
  C2:2. C2:4 | Bb1:2. Bb1:4 | Ab1:2. Ab1:4 | C2:1 |

pattern sub_secC =
  C1:1 | Ab0:1 | F0:1 | G0:1 |
  C1:1 | Bb0:1 | Ab0:1 | C1:1 |

pattern drm_secC =
  kick:4 R:2. | kick:4 R:2. | kick:4 R:2. | R:1 |
  kick:4 R:2. | kick:4 R:2. | kick:4 R:2. | R:1 |

# ============================================================================
# PHASE 5: CODA - EXTINCTION (Bars 41-44)
# Hollow open-fifth chord fading into absolute silence
# ============================================================================
pattern cello_coda   = (C3:1~1~1~1)@vol=1.000->0.005
pattern echo_coda    = (R:8 C3:1~1~1~2.~8)@vol=1.000->0.005
pattern violin_coda  = (G4:1~1~1~1)@vol=1.000->0.005
pattern oboe_coda    = (R:1 |)*4
pattern choir_coda   = ([C3 G3]:1~1~1~1)@vol=1.000->0.005
pattern organ_coda   = ([C2 G2 C3 G3]:1~1~1~1)@vol=1.000->0.005
pattern bells_coda   = (C5:1 | R:1 | R:1 | R:1)@vol=1.000->0.005
pattern harp_coda    = ((C3 G3 C4 Eb4 G4 Eb4 C4 G3):16*2 | (C3 G3 C4 G4):8*2 | (C3 G3):4*2 | C3:1)@vol=1.000->0.005
pattern strings_coda = ([C3 G3 C4]:1~1~1~1)@vol=1.000->0.005
pattern bass_coda    = (C2:1~1~1~1)@vol=1.000->0.005
pattern sub_coda     = (C1:1~1~1~1)@vol=1.000->0.005
pattern drm_coda     = (R:1 |)*4

# ============================================================================
# MULTI-CHANNEL SCORE ARRANGEMENT (44 Bars = 146.67s at 72 BPM)
# ============================================================================
track ch01_lead_cello    lead_cello:    cello_intro   cello_secA   cello_secB   cello_secC   cello_coda
track ch02_cello_echo    cello_echo:    echo_intro    echo_secA    echo_secB    echo_secC    echo_coda
track ch03_tragic_violin tragic_violin: violin_intro  violin_secA  violin_secB  violin_secC  violin_coda
track ch04_mournful_oboe mournful_oboe: oboe_intro    oboe_secA    oboe_secB    oboe_secC    oboe_coda
track ch05_gothic_choir  gothic_choir:  choir_intro   choir_secA   choir_secB   choir_secC   choir_coda
track ch06_church_organ  church_organ:  organ_intro   organ_secA   organ_secB   organ_secC   organ_coda
track ch07_sorrow_bells  sorrow_bells:  bells_intro   bells_secA   bells_secB   bells_secC   bells_coda
track ch08_weeping_harp  weeping_harp:  harp_intro    harp_secA    harp_secB    harp_secC    harp_coda
track ch09_strings_pad   strings_pad:   strings_intro strings_secA strings_secB strings_secC strings_coda
track ch10_somber_bass   somber_bass:   bass_intro    bass_secA    bass_secB    bass_secC    bass_coda
track ch11_sub_bass      sub_bass:      sub_intro     sub_secA     sub_secB     sub_secC     sub_coda
track ch12_funeral_toms  kick:          drm_intro     drm_secA     drm_secB     drm_secC     drm_coda
