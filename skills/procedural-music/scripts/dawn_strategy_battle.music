title "First Light on the Ramparts - Strategy RPG Dawn Battle"
type song
tempo allegro 128
time 4/4

# ============================================================================
# INSTRUMENT PALETTE (Studio Archetype Defaults + Tactical SRPG Overrides)
# ============================================================================
inst lead_horn     wave=ym2612_guitar  gm=overdriven_guitar vol=0.14 pan=-0.12 lpf=0.44
inst lead_echo     wave=ym2612_epiano  gm=french_horn       vol=0.09 pan=0.22  lpf=0.38
inst dawn_flute    wave=ym2612_flute   gm=flute             vol=0.11 pan=-0.22 lpf=0.40
inst brass_hi      wave=ym2612_brass   gm=brass_section     vol=0.12 pan=0.18  lpf=0.38
inst brass_mid     wave=ym2612_epiano  gm=synth_brass_1     vol=0.10 pan=-0.24 lpf=0.36
inst strings_pad   wave=ym2612_strings gm=string_ensemble_1 vol=0.10 pan=-0.28 lpf=0.32
inst dawn_bells    wave=ym2612_bell    gm=vibraphone        vol=0.055 pan=0.30 lpf=0.56
inst sunrise_harp  wave=psg_arp        gm=orchestral_harp   vol=0.065 pan=-0.40 lpf=0.40
inst tactical_bass wave=ym2612_bass    gm=electric_bass     vol=0.26 lpf=0.060
inst sub_bass      wave=sub_bass       gm=synth_bass_1      vol=0.25 lpf=0.038
inst kick          wave=kick           vol=0.19 pan=0.00
# 8-piece drum kit (kick, snare, tom_hi, tom_mid, tom_low, hat, open_hat, crash) is pre-seeded

# ============================================================================
# PHASE 1: PRE-DAWN MIST INTRO (Bars 1-8)
# Bars 1-4: Solitary flute & morning bells over shimmering harp and D pedal
# Bars 5-8: Martial snare & tom muster building to the tactical fanfare
# ============================================================================
pattern lead_intro =
  (R:1 |)*4
  D4:2. A4:4 | C5:2. G4:4 | Bb4:2 F4:4 G4 | A4:2. (A4 B4 C#5):8t |

pattern echo_intro =
  (R:1 |)*4
  R:8 D4:2. A4:8 | R:8 C5:2. G4:8 | R:8 Bb4:2 F4:4 G4:8 | R:8 A4:2~8 (A4 B4 C#5):8t |

pattern flute_intro =
  R:4 A4:2 C5:8 D5 | F5:2~8 E5:8 D5 C5 | D5:2. Bb4:4 | A4:1~1 |
  G4:2. D5:4 | F5:2 D5:4 Bb4 | E5:2. (E5 F#5 G5):8t |

pattern brass_hi_intro =
  (R:1 |)*4
  F4:8. F4:16 F4:8 R:8 A4:4. R:8 |
  E4:8. E4:16 E4:8 R:8 G4:4. R:8 |
  D4:8. D4:16 D4:8 R:8 F4:4. R:8 | E4:8. E4:16 E4:8 E4:8 A4:8.*2 A4:8 |

pattern brass_mid_intro =
  (R:1 |)*4
  D4:8. D4:16 D4:8 R:8 F4:4. R:8 |
  C4:8. C4:16 C4:8 R:8 E4:4. R:8 |
  Bb3:8. Bb3:16 Bb3:8 R:8 D4:4. R:8 | C#4:8. C#4:16 C#4:8 C#4:8 E4:8.*2 E4:8 |

pattern pad_intro =
  [D3 A3 D4]:1~1 | [Bb2 F3 Bb3]:1 | [A2 E3 A3]:1 |
  [D3 A3 D4]:1 | [C3 G3 C4]:1 | [Bb2 F3 Bb3]:1 | [A2 E3 A3]:1 |

pattern bells_intro =
  A5:2 D5 | C5:2 G5 | F5:2 Bb4 | E5:1 |
  D5:2 A5 | G5:2 C5 | F5:2 D5 | E5:2 A5 |

pattern harp_intro =
  ((D3 A3 D4 A4):16*4 |)*2
  (Bb2 F3 Bb3 F4):16*4 | (A2 E3 A3 E4):16*4 |
  (D3 A3 D4 A4):16*4 | (C3 G3 C4 G4):16*4 |
  (Bb2 F3 Bb3 F4):16*4 | (A2 E3 A3 E4):16*4 |

pattern bass_intro =
  D2:1~1 | Bb1:1 | A1:1 |
  (D2:8. D2:16 D2:8 A1:8 D2:8. D2:16 A1:4 |)*2
  Bb1:8. Bb1:16 Bb1:8 F1:8 Bb1:8. Bb1:16 F1:4 |
  A1:8. A1:16 A1:8 E1:8 A1:8.*2 A1:8 |

pattern drm_intro =
  (R:1 |)*3 R:2. (snare*3 kick):16 |
  (kick:8. kick:16 snare:8 kick:8 (snare*2):16 snare:8 kick:8 snare:8 |)*3
  kick:8 (snare*2):16 kick:8 (snare*2):16 (tom_hi*2 tom_mid*2):16 (snare*3 kick):16 |

# ============================================================================
# PHASE 2: SECTION A1 & A2 - TACTICAL ADVANCE AT DAYBREAK (16 Bars: D Dorian -> F Lift)
# Uses cross-bar ties (~ |), dotted-eighth tresillos (:8.), and triplet pickups (:8t)
# ============================================================================
pattern lead_secA =
  D5:2 A4:8. C5:8. D5:8 | G5:2. E5:8 D5 |
  C5:2 G4:8. A4:8. C5:8 | D5:1~4 F5:8 E5 D5:2 |
  D5:8. Bb4:8. F4:8 G4:2 |
  Bb4:2 F4:8. G4:8. Bb4:8 | A4:2. (A4 B4 C#5):8t |
  F5:2 C5:8. D5:8. F5:8 | G5:2. F5:8 D5 |
  E5:2 C5:8. D5:8. E5:8 | F5:1~4 A5:8 G5 F5:2 |
  F5:8. D5:8. A4:8 D5:2 |
  D5:2 Bb4:8. C5:8. D5:8 | E5:2. (E5 F#5 G5):8t |

pattern echo_secA =
  R:8 D5:2 A4:8. C5:8. | D5:8 G5:2. E5:8 |
  D5:8 C5:2 G4:8. A4:8. | C5:8 D5:1~4 F5:8 E5 D5:4. |
  D5:8 D5:8. Bb4:8. F4:8 G4:4. | G4:8 Bb4:2 F4:8. G4:8. | Bb4:8 A4:2~8 (A4 B4 C#5):8t |
  R:8 F5:2 C5:8. D5:8. | F5:8 G5:2. F5:8 |
  D5:8 E5:2 C5:8. D5:8. | E5:8 F5:1~4 A5:8 G5 F5:4. |
  F5:8 F5:8. D5:8. A4:8 D5:4. | D5:8 D5:2 Bb4:8. C5:8. | D5:8 E5:2~8 (E5 F#5 G5):8t |

pattern flute_secA =
  A5:2. F5:4 | G5:2. E5:4 | F5:2. D5:4 | E5:2. G5:4 |
  F5:2. D5:4 | D5:2. Bb4:4 | D5:2. F5:4 | E5:1 |
  C5:2. A5:4 | Bb5:2. G5:4 | G5:2. E5:4 | A5:1 |
  A5:2. F5:4 | F5:2. D5:4 | G5:2. Bb5:4 | A5:1 |

pattern brass_hi_secA =
  (A4:8 D5:8.*2 F5*2 F5:8 | G4:8 C5:8.*2 E5*2 E5:8 |)*2
  F4:8 Bb4:8.*2 D5*2 D5:8 | G4:8 Bb4:8.*2 D5*2 D5:8 |
  F4:8 Bb4:8.*2 D5:4 D5 | C#5:8. C#5:16 C#5:8 E5:8 A5:8.*2 A5:8 |
  A4:8 C5:8.*2 F5*2 F5:8 | G4:8 Bb4:8.*2 D5*2 D5:8 |
  G4:8 C5:8.*2 E5*2 E5:8 | A4:8 C5:8.*2 F5*2 F5:8 |
  A4:8 C5:8.*2 F5*2 F5:8 | A4:8 D5:8.*2 F5*2 F5:8 |
  G4:8 Bb4:8.*2 D5:4 D5 | C#5:8. C#5:16 C#5:8 E5:8 A5:8.*2 A5:8 |

pattern brass_mid_secA =
  (F4:8 A4:8.*2 D5*2 D5:8 | E4:8 G4:8.*2 C5*2 C5:8 |)*2
  D4:8 F4:8.*2 Bb4*2 Bb4:8 | D4:8 G4:8.*2 Bb4*2 Bb4:8 |
  D4:8 F4:8.*2 Bb4:4 Bb4 | A4:8. A4:16 A4:8 C#5:8 E5:8.*2 E5:8 |
  F4:8 A4:8.*2 C5*2 C5:8 | D4:8 G4:8.*2 Bb4*2 Bb4:8 |
  E4:8 G4:8.*2 C5*2 C5:8 | F4:8 A4:8.*2 C5*2 C5:8 |
  F4:8 A4:8.*2 C5*2 C5:8 | F4:8 A4:8.*2 D5*2 D5:8 |
  D4:8 G4:8.*2 Bb4:4 Bb4 | A4:8. A4:16 A4:8 C#5:8 E5:8.*2 E5:8 |

pattern pad_secA =
  ([D3 A3 D4]:1 | [C3 G3 C4]:1 |)*2
  [Bb2 F3 Bb3]:1 | [G2 D3 G3]:1 | [Bb2 F3 Bb3]:1 | [A2 E3 A3]:1 |
  [F2 C3 F3]:1 | [G2 D3 G3]:1 | [C3 G3 C4]:1 | [F2 C3 F3]:1 |
  [F2 C3 F3]:1 | [D3 A3 D4]:1 | [G2 D3 G3]:1 | [A2 E3 A3]:1 |

pattern bells_secA =
  (D5:4 R:2. | C5:4 R:2. |)*2
  Bb4:4 R:2. | G4:4 R:2. | D5:4 R:2. | E5:2 A5 |
  F5:4 R:2. | G5:4 R:2. | E5:4 R:2. | F5:4 C5 R:2 |
  A5:4 R:2. | F5:4 R:2. | G5:4 D5 R:2 | E5:2 A5 |

pattern harp_secA =
  ((D3 A3 D4 A4):16*4 | (C3 G3 C4 G4):16*4 |)*2
  (Bb2 F3 Bb3 F4):16*4 | (G2 D3 G3 D4):16*4 |
  (Bb2 F3 Bb3 F4):16*4 | (A2 E3 A3 E4):16*4 |
  (F3 C4 F4 C5):16*4 | (G3 D4 G4 D5):16*4 |
  (C3 G3 C4 G4):16*4 | (F3 C4 F4 C5):16*4 |
  (F3 C4 F4 C5):16*4 | (D3 A3 D4 A4):16*4 |
  (G2 D3 G3 D4):16*4 | (A2 E3 A3 E4):16*4 |

pattern bass_secA =
  (D2:8 (D2 D2):16 A1:8 D2:8 (D2 A1 D2 A1):16 D2:8 A1:8 |
   C2:8 (C2 C2):16 G1:8 C2:8 (C2 G1 C2 G1):16 C2:8 G1:8 |)*2
  Bb1:8 (Bb1 Bb1):16 F1:8 Bb1:8 (Bb1 F1 Bb1 F1):16 Bb1:8 F1:8 |
  G1:8 (G1 G1):16 D2:8 G1:8 (G1 D2 G1 D2):16 G1:8 D2:8 |
  Bb1:8 (Bb1 Bb1):16 F1:8 Bb1:8 (Bb1 F1 Bb1 F1):16 Bb1:8 F1:8 |
  A1:8. A1:16 A1:8 E1:8 A1:8.*2 A1:8 |
  F1:8 (F1 F1):16 C2:8 F1:8 (F1 C2 F1 C2):16 F1:8 C2:8 |
  G1:8 (G1 G1):16 D2:8 G1:8 (G1 D2 G1 D2):16 G1:8 D2:8 |
  C2:8 (C2 C2):16 G1:8 C2:8 (C2 G1 C2 G1):16 C2:8 G1:8 |
  F1:8 (F1 F1):16 C2:8 F1:8 (F1 C2 F1 C2):16 F1:8 C2:8 |
  F1:8 (F1 F1):16 C2:8 F1:8 (F1 C2 F1 C2):16 F1:8 C2:8 |
  D2:8 (D2 D2):16 A1:8 D2:8 (D2 A1 D2 A1):16 D2:8 A1:8 |
  G1:8 (G1 G1):16 D2:8 G1:8 (G1 D2 G1 D2):16 G1:8 D2:8 |
  A1:8. A1:16 A1:8 E1:8 A1:8.*2 A1:8 |

pattern drm_bar  = kick:8. kick:16 snare:8 kick:8 hat:8 kick:8 snare:4 |
pattern drm_fill4 = kick:8. kick:16 snare:8 kick:8 hat:8 kick:8 snare:8 (tom_hi*2):16 |
pattern drm_fill8 = crash:8 kick:8 snare:8 kick:8 hat:8 kick:8 (snare*2 tom_mid snare):16 |
pattern drm_secA = (drm_bar*3 drm_fill4 drm_bar*3 drm_fill8)*2

# ============================================================================
# PHASE 3: SECTION B - DAWN BREAKS (8 Bars: Radiant D Major Sunrise Modulation)
# Parallel Major shift (D minor -> D Major) as sunlight crests the ramparts
# ============================================================================
pattern lead_secB =
  F#5:2 D5:8. E5:8. F#5:8 | A5:2. F#5:8 D5 |
  B4:2 G4:8. A4:8. B4:8 | A4:2. F#5:4 |
  G5:8. E5:8. B4:8 G4:2 |
  F#5:2 D5:8. E5:8. F#5:8 | A5:2. F#5:4 | E5:2. (E5 F#5 G5):8t |

pattern echo_secB =
  R:8 F#5:2 D5:8. E5:8. | F#5:8 A5:2. F#5:8 |
  D5:8 B4:2 G4:8. A4:8. | B4:8 A4:2. F#5:8 |
  F#5:8 G5:8. E5:8. B4:8 G4:4. | G4:8 F#5:2 D5:8. E5:8. | F#5:8 A5:2. F#5:8 | F#5:8 E5:2~8 (E5 F#5 G5):8t |

pattern flute_secB =
  D5:2. F#5:4 | F#5:2. A5:4 | G5:2. B5:4 | F#5:2. D5:4 |
  D5:2. G5:4 | F#5:2. D5:4 | F#5:2. A5:4 | A5:1 |

pattern brass_hi_secB =
  A4:8. A4:16 D5:4 F#5:8.*2 D5:8 | B4:8. B4:16 D5:4 F#5:8.*2 D5:8 |
  B4:8. B4:16 D5:4 G5:8.*2 D5:8 | A4:8. A4:16 D5:4 F#5:8.*2 D5:8 |
  B4:8. B4:16 E5:4 G5:8.*2 E5:8 | A4:8. A4:16 D5:4 F#5:8.*2 D5:8 |
  A4:8. A4:16 D5:4 F#5:4 A5 | E5:8. E5:16 E5:8 G5:8 A5:8.*2 A5:8 |

pattern brass_mid_secB =
  F#4:8. F#4:16 A4:4 D5:8.*2 A4:8 | F#4:8. F#4:16 B4:4 D5:8.*2 B4:8 |
  G4:8. G4:16 B4:4 D5:8.*2 B4:8 | F#4:8. F#4:16 A4:4 D5:8.*2 A4:8 |
  G4:8. G4:16 B4:4 E5:8.*2 B4:8 | F#4:8. F#4:16 A4:4 D5:8.*2 A4:8 |
  F#4:8. F#4:16 A4:4 D5:4 F#5 | C#5:8. C#5:16 C#5:8 E5:8 E5:8.*2 E5:8 |

pattern pad_secB =
  [D3 A3 D4]:1 | [B2 F#3 B3]:1 | [G2 D3 G3]:1 | [D3 A3 D4]:1 |
  [E3 B3 E4]:1 | [D3 A3 D4]:1 | [D3 A3 D4]:1 | [A2 E3 A3]:1 |

pattern bells_secB =
  A5:4 F#5 D5 A4 | B4:4 D5 F#5 A5 | G5:4 D5 B4 G4 | A4:4 D5 F#5 A5 |
  G5:4 E5 B4 G4 | F#5:4 D5 A4 F#4 | A5:2 F#5:4 D5 | E5:2 A5 |

pattern harp_secB =
  (D3 A3 D4 F#4):16*4 | (B2 F#3 B3 D4):16*4 |
  (G2 D3 G3 B3):16*4 | (D3 A3 D4 F#4):16*4 |
  (E3 B3 E4 G4):16*4 | (D3 A3 D4 F#4):16*4 |
  (D3 A3 D4 F#4):16*4 | (A2 E3 A3 C#4):16*4 |

pattern bass_secB =
  D2:8 (D2 D2):16 A1:8 D2:8 (D2 A1 D2 A1):16 D2:8 A1:8 |
  B1:8 (B1 B1):16 F#1:8 B1:8 (B1 F#1 B1 F#1):16 B1:8 F#1:8 |
  G1:8 (G1 G1):16 D2:8 G1:8 (G1 D2 G1 D2):16 G1:8 D2:8 |
  D2:8 (D2 D2):16 A1:8 D2:8 (D2 A1 D2 A1):16 D2:8 A1:8 |
  E2:8 (E2 E2):16 B1:8 E2:8 (E2 B1 E2 B1):16 E2:8 B1:8 |
  D2:8 (D2 D2):16 A1:8 D2:8 (D2 A1 D2 A1):16 D2:8 A1:8 |
  D2:8 (D2 D2):16 A1:8 D2:8 (D2 A1 D2 A1):16 D2:8 A1:8 |
  A1:8. A1:16 A1:8 E1:8 A1:8.*2 A1:8 |

pattern drm_secB =
  crash:8 kick:16 kick:16 snare:8 kick:8 hat:8 kick:8 snare:4 |
  drm_bar*2 drm_fill4
  drm_bar*3 drm_fill8

# ============================================================================
# PHASE 4: SECTION C - WAR COUNCIL TURNAROUND BRIDGE (4 Bars: Gm7 -> Bb -> Asus4 -> A)
# Antiphonal tactical break pivoting back to the main battle cycle
# ============================================================================
pattern lead_secC =
  G5:8. D5:8. Bb4:8 G4:2 | F5:8. D5:8. Bb4:8 F4:2 |
  E5:8. D5:8. A4:8 G4:2 | A4:2. (A4 B4 C#5):8t |

pattern echo_secC =
  R:8 G5:8. D5:8. Bb4:8 G4:4. | R:8 F5:8. D5:8. Bb4:8 F4:4. |
  R:8 E5:8. D5:8. A4:8 G4:4. | R:8 A4:2~8 (A4 B4 C#5):8t |

pattern flute_secC =
  Bb5:2. G5:4 | F5:2. D5:4 | G5:2. E5:4 | E5:1 |

pattern brass_hi_secC =
  D5:8. D5:16 R:8 Bb4:8 G4:4. R:8 | D5:8. D5:16 R:8 Bb4:8 F4:4. R:8 |
  D5:8. D5:16 R:8 A4:8 G4:4. R:8 | C#5:8. C#5:16 C#5:8 E5:8 A5:8.*2 A5:8 |

pattern brass_mid_secC =
  Bb4:8. Bb4:16 R:8 G4:8 D4:4. R:8 | Bb4:8. Bb4:16 R:8 F4:8 D4:4. R:8 |
  A4:8. A4:16 R:8 E4:8 D4:4. R:8 | A4:8. A4:16 A4:8 C#5:8 E5:8.*2 E5:8 |

pattern pad_secC =
  [G2 D3 G3]:1 | [Bb2 F3 Bb3]:1 | [A2 D3 G3]:1 | [A2 E3 A3]:1 |

pattern bells_secC =
  G5:2 D5 | F5:2 Bb4 | E5:2 A4 | C#5:2 A5 |

pattern harp_secC =
  (G2 D3 G3 D4):16*4 | (Bb2 F3 Bb3 F4):16*4 |
  (A2 D3 G3 D4):16*4 | (A2 E3 A3 E4):16*4 |

pattern bass_secC =
  G1:8. G1:16 R:8 D2:8 G1:8. G1:16 D2:4 |
  Bb1:8. Bb1:16 R:8 F1:8 Bb1:8. Bb1:16 F1:4 |
  A1:8. A1:16 R:8 E1:8 A1:8. A1:16 E1:4 |
  A1:8. A1:16 A1:8 E1:8 A1:8.*2 A1:8 |

pattern drm_secC =
  (kick:8. kick:16 snare:8 R:8 (tom_hi*2 tom_mid*2):16 snare:4 |)*3
  crash:8 (snare*2):16 kick:8 (snare*2):16 (tom_hi*2 tom_mid*2):16 (snare*3 kick):16 |

# ============================================================================
# CODA: RADIANT SUNRISE OUTRO (4 Bars: D Major Dawn Chord Fade)
# ============================================================================
pattern lead_coda      = (F#5:1~1 | A5:1~1)@vol=1.000->0.005
pattern echo_coda      = (R:8 F#5:1~2.~8 | A5:1~1)@vol=1.000->0.005
pattern flute_coda     = (D5:1~1 | F#5:1~1)@vol=1.000->0.005
pattern brass_hi_coda  = (A4:1~1 | D5:1~1)@vol=1.000->0.005
pattern brass_mid_coda = (F#4:1~1 | A4:1~1)@vol=1.000->0.005
pattern pad_coda       = ([D3 A3 D4]:1~1~1~1)@vol=1.000->0.005
pattern bells_coda     = (A5:2 F#5 D5 A4 | D5:1~1)@vol=1.000->0.005
pattern harp_coda      = ((D3 A3 D4 F#4):16*4 |)*4@vol=1.000->0.005
pattern bass_coda      = (D2:1~1~1~1)@vol=1.000->0.005
pattern drm_coda       = (R:1 |)*4@vol=1.000->0.005

# ============================================================================
# MULTI-CHANNEL SCORE ARRANGEMENT (68 Bars = 127.50s at 128 BPM)
# ============================================================================
track ch01_lead_horn     lead_horn:     lead_intro (lead_secA lead_secB lead_secC)*2 lead_coda
track ch02_lead_echo     lead_echo:     echo_intro (echo_secA echo_secB echo_secC)*2 echo_coda
track ch03_dawn_flute    dawn_flute:    flute_intro (flute_secA flute_secB flute_secC)*2 flute_coda
track ch04_brass_hi      brass_hi:      brass_hi_intro (brass_hi_secA brass_hi_secB brass_hi_secC)*2 brass_hi_coda
track ch05_brass_mid     brass_mid:     brass_mid_intro (brass_mid_secA brass_mid_secB brass_mid_secC)*2 brass_mid_coda
track ch06_strings_pad   strings_pad:   pad_intro (pad_secA pad_secB pad_secC)*2 pad_coda
track ch07_dawn_bells    dawn_bells:    bells_intro (bells_secA bells_secB bells_secC)*2 bells_coda
track ch08_sunrise_harp  sunrise_harp:  harp_intro (harp_secA harp_secB harp_secC)*2 harp_coda
track ch09_tactical_bass tactical_bass: bass_intro (bass_secA bass_secB bass_secC)*2 bass_coda
track ch10_sub_bass      sub_bass:      bass_intro@-12 (bass_secA@-12 bass_secB@-12 bass_secC@-12)*2 bass_coda@-12
track ch11_drums_march   kick:          drm_intro (drm_secA drm_secB drm_secC)*2 drm_coda
