{
  "name": "agy-game-studio",
  "version": "0.2.0",
  "description": "2D game development studio and live WebAssembly Playtest & Procedural Sound Studio UI extension for Antigravity, Ebitengine, and Go.",
  "type": "module",
  "main": "sidecars/studio/main.mjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danicat/agy-game-studio.git"
  },
  "homepage": "https://github.com/danicat/agy-game-studio#readme",
  "bugs": {
    "url": "https://github.com/danicat/agy-game-studio/issues"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node sidecars/studio/main.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "antigravity",
    "plugin",
    "sidecar",
    "ui-extension",
    "ebitengine",
    "playtest-studio",
    "sound-studio",
    "procedural-audio",
    "procedural-music",
    "procedural-sfx",
    "chiptune",
    "synth",
    "ym2612",
    "coreaudio",
    "audio",
    "gamedev",
    "gemini"
  ],
  "author": "Daniela Petruzalek <daniela@danicat.dev> (https://danicat.dev)",
  "license": "Apache-2.0",
  "devDependencies": {
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  }
}
